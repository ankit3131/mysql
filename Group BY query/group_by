-- count city
SELECT city , count(*) as total_count
from groupby
GROUP BY city

-- find high salary
SELECT city , max(salary) as highest_salary
from groupby
GROUP BY city
ORDER BY highest_salary DESC

-- find avg salary
SELECT department , count(*) as total_employes,
avg(salary) as avg_salary
from groupby
GROUP BY department
HAVING COUNT(*) >= 2
AND avg(salary) > 500
ORDER BY avg_salary desc

-- find more than salary
SELECT department , count(*) AS total_number
from  groupby
where salary > 500
AND department = "IT"
GROUP BY department

