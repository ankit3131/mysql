-- count value
select count(*) total_name
FROM groupby

-- sum of total
select SUM(salary) total_salary
from groupby

-- avg of total
select avg(salary) average_salary
from groupby

-- max of total
select max(salary) as highest_Salary
from groupby

-- min of total
select min(salary) as total_salary
from groupby

-- group by count
select department , COUNT(*) as total_employe
FROM groupby
GROUP BY department

-- group by avg
select department , avg(salary) total_group
FROM groupby
GROUP BY department

-- gropup by sum
select department , sum(salary) total_group
FROM groupby
GROUP BY department

-- group by MAX
select department , max(salary) total_sum
FROM groupby
GROUP BY department

-- group by having
select department , COUNT(*) AS total_count
FROM groupby
GROUP BY department
HAVING COUNT(*) > 1

